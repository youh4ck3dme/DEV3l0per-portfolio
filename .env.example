# HTTP port for the Express server (default: 3000)
# Do not use 5000 on macOS — AirPlay Receiver binds it and responds with 403 (AirTunes)
PORT=3000

# Required in production
NODE_ENV=production

# Set to 1 when running behind a reverse proxy (nginx, Caddy, load balancer)
TRUST_PROXY=0

# Optional — required only for Phase 2 PostgreSQL integration
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
